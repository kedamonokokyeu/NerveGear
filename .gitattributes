# Git LFS — keep large binaries out of normal git history.
# Install once:  git lfs install
# Then large files matching these patterns are stored via LFS automatically.

*.pth   filter=lfs diff=lfs merge=lfs -text
*.pt    filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text
*.task  filter=lfs diff=lfs merge=lfs -text
*.h5    filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text

# Normalise line endings for text (helps Windows + git collaboration)
* text=auto
*.py    text eol=lf
*.js    text eol=lf
*.md    text eol=lf
